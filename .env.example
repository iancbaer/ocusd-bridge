ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
ETH_CUSTODY_CONTRACT=
OCTRA_RPC_URL=https://your-octra-node.example/rpc
OCTRA_TOKEN_CONTRACT=
RELAYER_OCTRA_ADDRESS=

# The Ethereum relayer key signs withdrawal approvals and submits withdraw() txs.
RELAYER_PRIVATE_KEY_ETH=

# The Octra relayer key submits mint() transactions.
RELAYER_PRIVATE_KEY_OCTRA=

POLL_INTERVAL_MS=3000
CONFIRMATIONS_REQUIRED=2
RELAYER_DB_PATH=relayer.sqlite
OCTRA_CALL_FEE=1000

# Deployment only.
DEPLOYER_PRIVATE_KEY=
RELAYER_SIGNER_ADDRESS=
INITIAL_OWNER_ADDRESS=
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# Optional Octra adapters while Octra's public signed-tx schema is settling.
# OCTRA_EVENTS_ENDPOINT can expose Burned events as JSON for the relayer.
# OCTRA_SUBMIT_ENDPOINT can be a local signer endpoint that submits contract calls.
OCTRA_EVENTS_ENDPOINT=
OCTRA_SUBMIT_ENDPOINT=

# Proof page
PROOF_PORT=8080
